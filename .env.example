# Copy to .env for local live-model runs.
# Never commit real API keys.

# Direct DeepSeek models, e.g. deepseek-v4-pro and deepseek-v4-flash.
DEEPSEEK_API_KEY=

# OpenRouter model slugs, e.g. anthropic/claude-sonnet-4.6.
OPENROUTER_API_KEY=

# Optional Garden/Mnemosyne graph for sortie journaling.
FLIGHT_GARDEN_GRAPH_ID=

# Common live-run tuning knobs.
PLANNER_MODEL=deepseek-v4-pro
BODY_MODEL=deepseek-v4-flash
TWITCH_BODY_MODEL=deepseek-v4-flash
BODY_TIMEOUT_MS=8000
BODY_MAX_TOKENS=96
BODY_MAX_RETRIES=2
BODY_EMPTY_RETRIES=1
